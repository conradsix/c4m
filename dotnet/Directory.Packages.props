<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The packages depend on the lowest versions they support, so a host is never made to change its versions. The
       tests and the sample pin current versions, as hosts run them. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EfCoreVersion>10.0.1</EfCoreVersion>
    <NpgsqlEfCoreVersion>10.0.0</NpgsqlEfCoreVersion>
    <NamingConventionsVersion>10.0.0</NamingConventionsVersion>
    <FastEndpointsVersion>8.0.0</FastEndpointsVersion>
    <FluentValidationVersion>12.1.1</FluentValidationVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' != 'true'">
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <EfCoreVersion>10.0.14</EfCoreVersion>
    <NpgsqlEfCoreVersion>10.0.3</NpgsqlEfCoreVersion>
    <NamingConventionsVersion>10.0.1</NamingConventionsVersion>
    <FastEndpointsVersion>8.3.0</FastEndpointsVersion>
    <FluentValidationVersion>12.2.0</FluentValidationVersion>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="EFCore.NamingConventions" Version="$(NamingConventionsVersion)" />
    <PackageVersion Include="FastEndpoints" Version="$(FastEndpointsVersion)" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="$(FastEndpointsVersion)" />
    <PackageVersion Include="FluentValidation" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Analyzers" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
