<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The smallest C4M host. @conradsix/c4m-client is generated from its OpenAPI document, and the EF tools use it as
       the startup project for the engine's migrations. -->
  <PropertyGroup>
    <SwaggerExportPath>$(MSBuildThisFileDirectory)obj/openapi</SwaggerExportPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcDirectory)\ConradSix.C4M\ConradSix.C4M.csproj" />
  </ItemGroup>

</Project>
