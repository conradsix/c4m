<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A headless CMS engine for ASP.NET Core: pages, versioned blocks and menus in PostgreSQL, served through FastEndpoints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\Sql\*.sql" LogicalName="ConradSix.C4M.Sql.%(Filename).sql" />
  </ItemGroup>

</Project>
