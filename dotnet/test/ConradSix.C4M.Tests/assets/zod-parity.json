[
  {
    "name": "a versioned block with required and optional fields",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "__typename": {
          "type": "string",
          "const": "note"
        },
        "__version": {
          "type": "number",
          "const": 2
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "subtitle": {
          "type": "string"
        }
      },
      "required": [
        "__typename",
        "__version",
        "title"
      ],
      "additionalProperties": false
    },
    "samples": [
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": "Hi"
        },
        "valid": true
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": "Hi",
          "subtitle": "There"
        },
        "valid": true
      },
      {
        "data": {
          "__typename": "note",
          "__version": 3,
          "title": "Hi"
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "quote",
          "__version": 2,
          "title": "Hi"
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": ""
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": "Much too long"
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": "Hi",
          "extra": true
        },
        "valid": false
      },
      {
        "data": {
          "__typename": "note",
          "__version": 2,
          "title": 5
        },
        "valid": false
      },
      {
        "data": "note",
        "valid": false
      }
    ]
  },
  {
    "name": "enums, nullables and defaults",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "plain",
            "accent"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "showButton": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "tone",
        "caption",
        "showButton"
      ],
      "additionalProperties": false
    },
    "samples": [
      {
        "data": {
          "tone": "plain",
          "caption": null,
          "showButton": true
        },
        "valid": true
      },
      {
        "data": {
          "tone": "accent",
          "caption": "Hello",
          "showButton": false
        },
        "valid": true
      },
      {
        "data": {
          "tone": "loud",
          "caption": null,
          "showButton": true
        },
        "valid": false
      },
      {
        "data": {
          "tone": "plain",
          "caption": 3,
          "showButton": true
        },
        "valid": false
      },
      {
        "data": {
          "tone": "plain",
          "caption": null
        },
        "valid": false
      }
    ]
  },
  {
    "name": "unions and discriminated unions",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "link": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "page"
                },
                "pageRef": {
                  "type": "object",
                  "properties": {
                    "__typename": {
                      "type": "string",
                      "const": "page-ref"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "__typename",
                    "id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "pageRef"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "url"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "value",
        "link"
      ],
      "additionalProperties": false
    },
    "samples": [
      {
        "data": {
          "value": "a",
          "link": {
            "kind": "page",
            "pageRef": {
              "__typename": "page-ref",
              "id": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e"
            }
          }
        },
        "valid": true
      },
      {
        "data": {
          "value": 1.5,
          "link": {
            "kind": "url",
            "url": "https://example.com/a?b=c#d"
          }
        },
        "valid": true
      },
      {
        "data": {
          "value": true,
          "link": {
            "kind": "url",
            "url": "https://example.com"
          }
        },
        "valid": false
      },
      {
        "data": {
          "value": "a",
          "link": {
            "kind": "url",
            "url": "not a url"
          }
        },
        "valid": false
      },
      {
        "data": {
          "value": "a",
          "link": {
            "kind": "page",
            "url": "https://example.com"
          }
        },
        "valid": false
      },
      {
        "data": {
          "value": "a",
          "link": {
            "kind": "file",
            "url": "https://example.com"
          }
        },
        "valid": false
      }
    ]
  },
  {
    "name": "arrays, tuples and records",
