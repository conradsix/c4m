  {
    "name": "string formats",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "pattern": "^[a-z]+-\\d{2}$"
        },
        "uuid": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "day": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "pattern",
        "uuid",
        "email",
        "url",
        "at",
        "day"
      ],
      "additionalProperties": false
    },
    "samples": [
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "a@example.com",
          "url": "https://example.com/x",
          "at": "2026-10-31T12:30:00Z",
          "day": "2026-10-31"
        },
        "valid": true
      },
      {
        "data": {
          "pattern": "abc-123",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "a@example.com",
          "url": "https://example.com/x",
          "at": "2026-10-31T12:30:00Z",
          "day": "2026-10-31"
        },
        "valid": false
      },
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "not-a-uuid",
          "email": "a@example.com",
          "url": "https://example.com/x",
          "at": "2026-10-31T12:30:00Z",
          "day": "2026-10-31"
        },
        "valid": false
      },
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "not an email",
          "url": "https://example.com/x",
          "at": "2026-10-31T12:30:00Z",
          "day": "2026-10-31"
        },
        "valid": false
      },
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "a@example.com",
          "url": "example.com",
          "at": "2026-10-31T12:30:00Z",
          "day": "2026-10-31"
        },
        "valid": false
      },
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "a@example.com",
          "url": "https://example.com/x",
          "at": "yesterday",
          "day": "2026-10-31"
        },
        "valid": false
      },
      {
        "data": {
          "pattern": "abc-12",
          "uuid": "019a3a3c-0b8e-7c7d-9d1e-2f3a4b5c6d7e",
          "email": "a@example.com",
          "url": "https://example.com/x",
          "at": "2026-10-31T12:30:00Z",
          "day": "31/10/2026"
        },
        "valid": false
      }
    ]
  },
