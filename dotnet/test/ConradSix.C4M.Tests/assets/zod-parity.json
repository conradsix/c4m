      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "pattern": "^(?!\\s*$)(?!\\s*(?:none|standard)\\s*$).+$"
        },
        "word": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      },
      "required": [
        "condition",
        "word",
        "slug"
      ],
      "additionalProperties": false
    },
