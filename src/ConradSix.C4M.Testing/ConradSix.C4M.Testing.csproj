<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test helpers for C4M hosts: fakes for the engine's hooks, and seeding and clearing its tables. -->
  <ItemGroup>
    <ProjectReference Include="..\ConradSix.C4M\ConradSix.C4M.csproj" />
  </ItemGroup>

  <!-- The public API is recorded in PublicAPI.*.txt; an unrecorded change fails the build. -->
